{
  "name": "drupal/ts_motif",
  "type": "drupal-theme",
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:thinkshout/base-assets.git"
    }
  ], 
  "require-dev": {
    "drupal/coder": "^8.3",
    "squizlabs/php_codesniffer": "^3.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7.2",
    "thinkshout/base-assets": "*"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "code-sniff": [
      ".\/vendor\/bin\/phpcs --standard=Drupal --extensions=php,module,inc,install,test,profile,theme,info --ignore=node_modules,bower_components,vendor .",
      ".\/vendor\/bin\/phpcs --standard=DrupalPractice --extensions=php,module,inc,install,test,profile,theme,info --ignore=node_modules,bower_components,vendor ."
    ],
    "code-sniff-fix": [
      ".\/vendor\/bin\/phpcbf --standard=Drupal --extensions=php,module,inc,install,test,profile,theme,info --ignore=node_modules,bower_components,vendor .",
      ".\/vendor\/bin\/phpcbf --standard=DrupalPractice --extensions=php,module,inc,install,test,profile,theme,info --ignore=node_modules,bower_components,vendor ."
    ],
    "scaffold": [
      "git clone git@github.com:thinkshout/base-assets.git",
      "rsync -r base-assets/scaffold/ ./",
      "rsync -r views templates/",
      "rm -rf views",
      "rm -rf base-assets",
      "mv templates/pages/page-style-guide.twig templates/pages/styleguide.html.twig",
      "sed -I '' 's/views/templates/g' assets/css/index.css assets/js/main.js tailwind.config.js templates/organisms/blocks/banner/display/banner.css",
      "find . -name '*.twig' -execdir sed -I '' 's/@thinktimber/@ts_motif/g' {} +"
    ]
  }
}
