{# Card 2XL
 *
 * Seen on Poster paragraph.
 *
 * Variables:
 * - has_image
 * - eyebrow
 * - title
 * - text
 * - link
 * - link2
#}

{% set link_title = link.title ? link.title : false %}
{% set link_url = link.url ? link.url : link %}

{% if title or text and image %}
  <div class="card-xl my-block colorway-card relative">
    <div class="ts-grid-col-2">

      {# Image #}
      {% if has_image %}
        <div class="mb-4 md:mb-0">
          {% set classes = "aspect-[16/9] object-cover overflow-hidden lazyloaded w-full" %}
          {% block card_image %}
          {% endblock %}
        </div>
      {% endif %}

      {# Text Wrapper #}
      <div class="flex flex-col justify-center md:max-w-[600px]">
        <div>

          {# Text Wrapper #}
          <div class="p-4 md:p-10">

            {# Tag #}
            {% if btn_tag_text %}
              <div class="mb-sm">
                {% include '@ts_motif/atoms/btns/btn-tag.twig' with {
                  text: btn_tag_text
                } %}
              </div>
            {% endif %}

            {# Card overlay link: needs to be immediately followed by the .card-title for hover/focus styles #}
            {% include '@ts_motif/molecules/cards/card-overlay-link.html.twig' with { link_url: link_url } %}

            {# Title #}
            {% if title %}
              <a href="{{ link_url }}" class="color-secondary card-title-hocus">
                <h3 class="h3 mb-sm">
                  {{ title }}
                </h3>
              </a>
            {% endif %}

            {# Text Small #}
            {% if text_small %}
              <div class="body-xs mb-8 color-secondary">
                <span class="color-secondary">By </span>
                {{ author }}
                <span class="color-secondary">on</span>
                <span>{{ date }}</span>
              </div>
            {% endif %}

            {# Text #}
            {% if text %}
              <div class="body-sm mb-8 color-secondary">{{ text }}</div>
            {% endif %}

            {# Buttons #}
            {% if link_title %}
              <div>
                {% include '@ts_motif/btns/btn-solid.twig' with {
                  link: { title: link_title, url: link_url },
                  size: 'lg',
                } %}
              </div>
            {% endif %}

          </div> {# end Text Wrapper #}

        </div>
      </div>
    </div>
  </div>
{% endif %}

