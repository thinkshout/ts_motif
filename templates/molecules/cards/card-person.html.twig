{# Card Person
 *
 * Variables:
 * - has_image
 * - title
 * - link
 * - link_url
#}

{% set link_url = link.url ? link.url : link %}

<div class="card-person relative ts-hocus-scale">

  {# Image #}
  {% if has_image %}
    {% set classes = image_classes %}
    <div class="{{ image_wrapper_classes }}">
      {% block card_image %}
      {% endblock %}
    </div>
  {% endif %}

  {# Text Wrapper #}
  <div class="py-6">

    {# Title #}
    {% include '@ts_motif/molecules/cards/card-overlay-link.html.twig' with { link_url: link_url } %}
    {% if title %}
      <a href="{{ link_url }}" class="color-primary card-title-hocus">
        <h3 class="h3 mb-1">
          {{ title }}
        </h3>
      </a>
    {% endif %}
    {% if text %}
      <p class="body-sm color-secondary">{{ text }}</p>
    {% endif %}

  </div> {# end Text Wrapper #}
</div>
