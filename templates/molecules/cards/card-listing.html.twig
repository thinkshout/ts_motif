{# Card Search Listing
 *
 * Seen on Search Listing.
 * Variables:
 * - has_image
 * - btn_tag_text
 * - title
 * - text
 * - text_small
 * - link_url
 * - link
#}

{% set link_url = link.url ? link.url : link %}

<div class="colorway-card card-listing flex rounded-[10px] relative colorway-white ts-hocus-scale py-md">

  {# Image #}
  {% if has_image %}
    <div class="inline-block mr-sm max-w-16">
      {% block card_image %}
      {% endblock %}
    </div>
  {% endif %}

  {# Text wrapper #}
  <div class="inline-block">

    {# Tag #}
    {% if btn_tag_text %}
      <div class="mb-1">
        {% include '@ts_motif/atoms/btns/btn-tag.twig' with {
          text: btn_tag_text
        } %}
      </div>
    {% endif %}

    {# Full Card Link #}
    {% include '@ts_motif/molecules/cards/card-overlay-link.html.twig' with { link_url: link_url } %}

    {# Title #}
    <a href="{{ link_url }}" class="card-title-hocus"><h3 class="h3 mb-1 color-primary">{{ title }}</h3></a>

    {# Text #}
    {% if text %}
      <p class="body-sm mb-1 color-primary">{{ text }}</p>
    {% endif %}

    {# Small Text #}
    {% if text_small %}
      <div class="color-secondary body-xs">
        {{ text_small }}
      </div>
    {% endif %}

  </div> {# End text wrapper #}

</div>
