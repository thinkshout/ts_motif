{# Submenu in header nav
 *
 * Variables:
 * - items
#}

{% if items %}
	<ul class="{{ menu_wrapper_classes }} menu-main--submenu colorway-white ts-border-radius absolute flex-col gap-y-sm
	left-0 top-10 pt-2 px-4 pb-4 min-w-[12.5rem]">
	{% for item in items %}
		<li class="menu-item color-primary body-sm">
			<a target="{{ item.target }}" class="hocus-action hocus-underline" href="{{ item.link }}">{{ item.title }}</a>
		</li>
	{% endfor %}
	</ul>
{% endif %}
