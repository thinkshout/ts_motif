{# Color: All colors in the palette
 *
#}

{%
  set row1 = [
  'black',
  'white',
]
%}

{%
  set row2 = [
  'neutral-900',
  'neutral-800',
  'neutral-700',
  'neutral-600',
  'neutral-500',
  'neutral-400',
  'neutral-300',
  'neutral-200',
  'neutral-100',
  'neutral-50'
]
%}
{%
  set row3 = [
  'purple-900',
  'purple-700',
  'purple-500',
  'purple-300',
  'purple-100',
]
%}
{%
  set row4 = [
  'error-500',
  'warning-500',
  'success-500',
]
%}
{%
  set row5 = [
  'error-100',
  'warning-100',
  'success-100'
]
%}
{% set color_rows = [
  row1,
  row2,
  row3,
  row4,
  row5,
] %}

<span class="
bg-black bg-white bg-neutral-900 bg-neutral-800 bg-neutral-700 bg-neutral-600 bg-neutral-500 bg-neutral-300
bg-neutral-200 bg-purple-900 bg-purple-700 bg-purple-500 bg-purple-300 bg-purple-100 bg-neutral-100 bg-error-500
bg-error-100 bg-warning-500 bg-warning-100 bg-success-100 bg-success-500
md:gap-4 color-primary color-secondary color-action"></span>

{# Add components/blocks here... #}
<section class="py-4">
  <div class="xl:container">
    <h2 class="h3">Color</h2>
    {% for color_row in color_rows %}
      <div class="grid grid-cols-5 gap-4 mb-12">
        {% for color1 in color_row %}
          <div class="col-span-1">
            <div class="bg-{{ color1 }} color-primary body-bold p-3 shadow rounded-8 w-full h-12
            mb-3"></div>
            <label class="body-sm">{{ color1 }}</label>
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</section>