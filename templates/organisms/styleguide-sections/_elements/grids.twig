{# Layouts
 * All grids in use, styled in utilities.css.
#}
{% set gridStyle = "bg-neutral-200 p-9" %}
{% set headerClasses = "utility-xs my-3" %}

<div class="">
  <h2 class="h3 mb-2">Grids</h2>
  <p class="utility-sm m-zero">Developer notes: Defined in tailwind-grids.json. Use "xl:container p-site" for site
    container and padding
    .</p>
</div>
