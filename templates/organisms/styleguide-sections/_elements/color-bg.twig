{# Color: Background
 *
 * bg colors have logic written in colors.css to change the text color based on the bg.
#}


{%
  set bgColors = [
  'colorway-dark',
  'colorway-white',
  'colorway-light',
  'colorway-neutral-100'
]
%}

<span class="bg-black bg-white bg-neutral-100 bg-neutral-500"></span>

<section class="py-4">
  <div class="xl:container">
    <h2 class="h4">Background colors</h2>
    <div class="grid grid-cols-4 gap-4 mt-6">
      {% for color in bgColors %}
        <div class="col-span-1">
          <div class="{{ color }} color-primary body-bold text-sm p-3 shadow rounded-8 w-full h-12 mb-3">
          </div>
          <label class="body-sm">.{{ color }}</label>
        </div>
      {% endfor %}
    </div>
  </div>
</section>