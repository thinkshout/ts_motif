{#
  Accordion Block
  Relevant JS: /assets/js/components/accordion.js
  Relevant CSS: /assets/css/components/accordion.css
#}

{% set accordion = accordion|default([]) %}

<div class="block--accordion accordion ts-lovey bg-neutral-50">
  <div class="wysiwyg-container divide-y divide-neutral-300 ts-block-container">
    {% for accordion_section in accordion %}
      <div class="accordion__section wysiwyg-content py-2">
        <button class="accordion__section__toggle hover:color-purple-500 focus:color-purple-500 text-neutral-800 w-full
        flex items-center justify-between
        py-6">
          <h3 class="accordion__section__title inline-block h4 text-left">{{
            accordion_section.title
            }}</h3>
          <div class="accordion__section__icon">
            <span class="icon-layer ts-svg-high-contrast block h-6 w-2">
              {% include 'atoms/svg-icon-embed.twig' with {
                'svg_name': "chevron-right",
              } only %}
            </span>
            <span class="icon-layer"></span>
          </div>
        </button>
        <div class="accordion__section__content mce-content-body body-base text-neutral-800 px-6">
          {{ accordion_section.content }}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
