{# Banner -- centered
 *
 * See banner.html.twig for full variables.
#}

{% set aspect_ratio = " aspect-[21/9] " %}
{% set image_classes = " lazyloaded object-cover w-full " ~ aspect_ratio %}
{% set image_wrapper_classes = " overflow-hidden " ~ aspect_ratio %}

{% set padding = "" %}

<span class="hidden lg:aspect-[21/9]"></span>

<div class="block--banner--fullbleed flex flex-col-reverse md:flex-col relative colorway-light {{ padding }}">

  {# Image #}
  <div class="banner--center-image-wrapper -mt-10 md:mt-0 z-0 {{ image_wrapper_classes }} {{ colorway }}">
    {% include 'molecules/image/media.twig' with {
      image: image,
      classes: image_classes,
      caption_style: "hidden",
      bg_figcaption: "",
      figcaption_classes: 'color-secondary p-1 lg:px-0 lg:pb-0 absolute left-6 bottom-0'
    } %}
  </div>

  <div class="xl:container p-site">
    {# Text Wrapper #}
    <div class="colorway-white mt-16 md:-mt-[150px] mx-auto rounded-10 relative z-5 md:w-[80%] p-4 md:p-12">
      {% include 'molecules/section-title/section-title.twig' with {
        eyebrow: eyebrow,
        header: title,
        text: text,
        primary_btn: primary_btn,
        secondary_btn: secondary_btn,
        secondary_btn: secondary_btn,
        style: "center",
        header_tag: is_hero ? "h1" : "h2",
        margin: ""
      } %}
    </div>  {# Closes Text wrapper #}
  </div>

</div>
