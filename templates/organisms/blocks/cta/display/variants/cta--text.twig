{# CTA text
 * - eyebrow
 * - title
 * - text
#}

{# Text #}
{# Eyebrow #}
{% if eyebrow %}
  <p class="h5 color-primary">{{ eyebrow }}</p>
{% endif %}
{% if title %}
  <h2 class="h2 color-primary">{{ title }}</h2>
{% endif %}
{% if text %}
  <div class="wysiwyg-wrapper color-primary">
    {{ text }}
  </div>
{% endif %}
