{% extends '@ts_motif/base.twig' %}

{% block content %}
  {% set bg_color = 'colorway-white' %}
  <div class="content-wrapper">
    <article class="post-type-{{ post.post_type }} {{ bg_color }}" id="post-{{ post.ID }}">
      {% include '@ts_motif/organisms/blocks/banner/hero.twig' with {
        presentation: 'default',
        is_hero: 1
      } %}
      <main class="article-content">
        <div class="article-body">
          {{ post.content }}
        </div>
      </main>
    </article>
  </div><!-- /content-wrapper -->
{% endblock %}
